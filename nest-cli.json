{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "generated/prisma/client/**/*.{js,d.ts}",
        "outDir": "dist/src"
      }
    ]
  },
  "generateOptions": {
    "spec": true
  }
}
