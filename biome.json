{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "bracketSameLine": true,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "performance": {
        "noAwaitInLoops": "error",
        "noBarrelFile": "error"
      },
      "security": "error",
      "complexity": "error",
      "style": {
        "useImportType": "off"
      },
      "correctness": {
        "noChildrenProp": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true,
      "jsxEverywhere": true
    },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "indentStyle": "space",
      "bracketSameLine": true,
      "lineWidth": 120,
      "bracketSpacing": true,
      "arrowParentheses": "asNeeded",
      "jsxQuoteStyle": "single",
      "semicolons": null
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
