APP_NAME=MyNestApp
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=my-secret-pw
DATABASE_NAME=my_nest_app
DATABASE_URL="postgresql://username:password@localhost:5432/mydb?schema=public"

# Security - password hashing
PEPPER=some-really-long-string-that-is-unique-to-something-or-someone
HASH_ROUNDS=10

# Email verification
EMAIL_VERIFICATION_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_SECRET=email-verification-secret-key-change-in-production
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400

# Authentication tokens
AUTH_TOKEN_SECRET=auth-token-secret-key-change-in-production
AUTH_TOKEN_TTL_SECONDS=86400